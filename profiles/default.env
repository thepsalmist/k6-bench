# Approximates a 2 vCPU / 4 GB VPS across db + web + worker. The broker (Celery target only) is extra.
DB_CPUS=0.8
DB_MEM=1536m
WEB_CPUS=0.7
WEB_MEM=1024m
WORKER_CPUS=0.5
WORKER_MEM=1024m
BROKER_CPUS=0.25
BROKER_MEM=256m
WEB_WORKERS=2
WEB_THREADS=4
WORKER_CONCURRENCY=4
CELERY_POOL=prefork
CELERY_DB_REUSE_MAX=1000000
SCENARIO_ITEM_COUNT=100000
